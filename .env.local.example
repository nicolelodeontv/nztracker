# Supabase server-only credentials
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY
# Legacy alternative supported until migration is complete:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Ninja Zenshin live source
GAME_AMF_ORIGIN=https://amf.ninjazenshin.online/
GAME_MEMBER_SERVICE=ClanService.getMemberList
GAME_MEMBER_RESPONSE_TARGET=/1
GAME_SOURCE_ORIGIN=https://ninjazenshin.online

# Scheduled member tracking (comma-separated clan IDs; default is Chaos / clan 3)
TRACKED_CLAN_IDS=3

# Admin access
ADMIN_PASSWORD=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM
ADMIN_NAME=CHAOS Admin

# Optional scheduled sync secret
CRON_SECRET=CHANGE_ME_LONG_RANDOM
